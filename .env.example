# MajiPulse environment variables. PLACEHOLDERS ONLY. Never put real values in this file.
# Copy to .env.local (git-ignored) and fill in values from the Firebase console.
# Firebase web config values are identifiers, not secrets; rules and App Check provide security.

VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# App Check reCAPTCHA site key (public). Provider type is confirmed in a later task.
VITE_APPCHECK_SITE_KEY=your-recaptcha-site-key

# Set to true to connect to local Firebase emulators.
VITE_USE_EMULATORS=false

# App Check debug token: put it ONLY in .env.development.local (git-ignored), never here
# and never in .env.local. It is read only in development builds.
# VITE_APPCHECK_DEBUG_TOKEN=
