{
  "name": "majipulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:emulators": "npm run functions:build && playwright test --config playwright.emulator.config.ts",
    "test:rules": "node scripts/firebase-emulators.mjs emulators:exec --only firestore --project demo-majipulse \"vitest run --config vitest.emulator.config.ts tests/emulator/rules\"",
    "test:emulators": "npm run functions:build && node scripts/firebase-emulators.mjs emulators:exec --only auth,firestore,functions --project demo-majipulse \"vitest run --config vitest.emulator.config.ts\"",
    "emulators": "npm run functions:build && node scripts/firebase-emulators.mjs emulators:start --project demo-majipulse",
    "functions:build": "npm --prefix functions run build",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "firebase": "^13.3.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "firebase-tools": "^15.36.0",
    "globals": "^17.13.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
